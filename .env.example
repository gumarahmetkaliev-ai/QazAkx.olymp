# ИИ-жюри через OmniRoute (используется первым, если заданы ключ и адрес)
# OMNIROUTE_API_KEY=your_omniroute_key
# OMNIROUTE_ENDPOINT=https://your-omniroute-host/v1
# OMNIROUTE_MODEL=auto
# OMNIROUTE_PARSE_MODEL=        # модель для npm run build-tasks -- --ai (необязательно)

# ИИ-жюри (OpenRouter): https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
# Модель для проверки ответов (хорошо работают google/gemini-2.5-flash, anthropic/claude-sonnet-4.5, openai/gpt-4.1)
OPENROUTER_MODEL=google/gemini-2.5-flash
# Модель для разбора PDF в задачи (npm run build-tasks -- --ai)
# OPENROUTER_PARSE_MODEL=google/gemini-2.5-pro

# Вход и синхронизация прогресса (см. SUPABASE_SETUP.md)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Другие провайдеры (необязательно, используются как запасные)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Только для локальной проверки интерфейса без ключа: фейковое жюри
# QAZAKX_FAKE_AI=1

PORT=3000
