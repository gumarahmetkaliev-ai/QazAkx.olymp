# Google Gemini API Key (optional, required for AI if no other provider configured)
# Get a free key at: https://aistudio.google.com/
# GEMINI_API_KEY=your_google_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# Anthropic / OmniRoute (optional, preferred fallback)
# ANTHROPIC_API_KEY=your_anthropic_or_omniroute_key_here
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Groq (optional, secondary fallback)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=meta-llama-4-8b-instant

# OpenRouter / OpenAI fallback (optional)
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Server Port (optional, defaults to 3000)
PORT=3000
