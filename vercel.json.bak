{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/olympiads/:path*.pdf",
      "destination": "/public/olympiads/:path*.pdf"
    },
    {
      "source": "/olympiads/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/olympiads/:path*.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/public/olympiads/:path*.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
