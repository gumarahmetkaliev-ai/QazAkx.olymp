          <div class="chat-chip" onclick="sendQuickPrompt('Объясни закон Гесса и расчет энтальпии реакции')">🔥 Закон Гесса</div>
          <div class="chat-chip" onclick="sendQuickPrompt('Как использовать уравнение Аррениуса для энергии активации?')">⏱ Уравнение Аррениуса</div>
          <div class="chat-chip" onclick="sendQuickPrompt('Как рассчитать pH буферного раствора?')">🧪 pH буфера</div>
        </div>
        <div class="chat-input-area">
