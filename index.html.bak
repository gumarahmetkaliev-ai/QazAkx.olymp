    <div id="chemistry" class="page">
      <div class="container" style="padding-top: 60px">
        <div class="breadcrumbs">
          <a href="#" onclick="goToPage('home')">Главная</a>
          <span>→</span>
          <a href="#" onclick="goToPage('subject')">Предметы</a>
          <span>→</span>
          <a href="#" onclick="goToPage('grade')">Класс</a>
          <span>→</span>
          <span>Химия</span>
        </div>

        <div
          style="
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
          "
        >
          <h1 style="color: var(--primary)">
            🧪 Химия • <span id="current-grade">10</span> класс
          </h1>
          <button class="btn btn-secondary" onclick="goToPage('grade')">
            <i class="fas fa-exchange-alt"></i> Сменить класс
          </button>
        </div>

        <div class="grid grid-3" style="max-width: 1050px; margin: 0 auto 40px">
          <div class="card" onclick="goToPage('checker')" style="cursor: pointer; border: 2px solid var(--primary); background: linear-gradient(180deg, #ffffff, #f4f3ff);">
            <div class="card-icon" style="color: var(--primary)">🤖</div>
            <div class="badge" style="background: #e0e7ff; color: #4338ca;">Умная проверка</div>
            <h3>AI Анализ решений</h3>
            <p style="margin-bottom: 20px">
              Проверка твоего решения олимпиадным жюри
            </p>
            <ul
              style="text-align: left; padding-left: 20px; margin-bottom: 25px"
            >
              <li style="margin-bottom: 8px">Поиск и объяснение ошибок</li>
              <li style="margin-bottom: 8px">Подсказки без спойлеров</li>
              <li>Олимпиадные баллы 7-11 классов</li>
            </ul>
            <div class="btn">Проверить решение →</div>
          </div>

          <div class="card" onclick="goToPage('tasks')" style="cursor: pointer">
            <div class="card-icon" style="color: var(--primary)">📝</div>
            <h3>Олимпиадные задания</h3>
            <p style="margin-bottom: 20px">
              Более 500 задач разных уровней сложности
            </p>
            <ul
              style="text-align: left; padding-left: 20px; margin-bottom: 25px"
            >
              <li style="margin-bottom: 8px">По темам</li>
              <li style="margin-bottom: 8px">Республиканские олимпиады</li>
              <li>Интерактивная AI-проверка</li>
            </ul>
            <div class="btn">Перейти →</div>
          </div>

          <div
            class="card"
            onclick="goToPage('videos')"
            style="cursor: pointer"
          >
            <div class="card-icon" style="color: var(--accent)">🎥</div>
            <h3>Видеоуроки</h3>
            <p style="margin-bottom: 20px">54 реальных видеоурока по химии</p>
            <ul
              style="text-align: left; padding-left: 20px; margin-bottom: 25px"
            >
              <li style="margin-bottom: 8px">24 урока для 7 класса</li>
