    <div id="checker" class="page">
      <div class="container" style="padding-top: 60px">
        <div class="breadcrumbs">
          <a href="#" onclick="goToPage('home')">Главная</a>
          <span>→</span>
          <a href="#" onclick="goToPage('subject')">Предметы</a>
          <span>→</span>
          <a href="#" onclick="goToPage('chemistry')">Химия</a>
          <span>→</span>
          <span>AI Проверка олимпиадных решений</span>
        </div>

        <div class="checker-hero">
          <div class="checker-hero-content">
            <span class="checker-badge"><i class="fas fa-robot"></i> AI Olympiad Jury & Tutor</span>
            <h1>AI Проверка олимпиадных решений</h1>
            <p>
              Пошаговый анализ твоего решения, детальный разбор ошибок с точки зрения химии, подсказки без спойлеров и олимпиадная оценка.
            </p>
          </div>
          <div style="display: flex; gap: 10px; align-items: center;">
            <span id="ai-server-badge" class="badge" style="background: rgba(255,255,255,0.2); color: white; margin-bottom: 0;">
              <i class="fas fa-circle" style="color: #4ade80; font-size: 10px;"></i> Сервер AI активен
            </span>
          </div>
        </div>

        <div class="checker-workspace">
          <!-- Левая колонка: Ввод задачи и решения -->
          <div class="workspace-card">
            <div class="workspace-card-header">
              <div class="workspace-card-title">
                <i class="fas fa-edit"></i> Ваше решение
              </div>
              <button class="btn btn-secondary" style="padding: 4px 10px; font-size: 12px;" onclick="loadSampleDraft()">
                <i class="fas fa-magic"></i> Загрузить пример
              </button>
            </div>

            <!-- Выбор класса -->
            <div class="form-group">
              <label class="form-label">Класс олимпиады:</label>
              <div class="pill-group" id="checker-grade-pills">
                <button class="pill-btn" onclick="setCheckerGrade(7)">7 класс</button>
                <button class="pill-btn" onclick="setCheckerGrade(8)">8 класс</button>
                <button class="pill-btn" onclick="setCheckerGrade(9)">9 класс</button>
                <button class="pill-btn active" onclick="setCheckerGrade(10)">10 класс</button>
                <button class="pill-btn" onclick="setCheckerGrade(11)">11 класс</button>
              </div>
            </div>

            <!-- Быстрый выбор задачи из базы -->
            <div class="form-group">
              <label class="form-label" for="checker-task-select">
                Выбрать олимпиадную задачу:
                <span class="hint-text">(или введи условие вручную ниже)</span>
              </label>
              <select id="checker-task-select" class="task-quick-selector" onchange="onTaskSelectChange()">
                <!-- Опции генерируются динамически -->
              </select>
            </div>

            <!-- Условие задачи -->
            <div class="form-group">
              <label class="form-label" for="checker-problem">
                Условие задачи: <span style="color: #ef4444;">*</span>
              </label>
              <textarea
                id="checker-problem"
                class="custom-textarea"
                rows="4"
                placeholder="Вставьте условие химической задачи (уравнения, массы, объемы, термодинамические данные...)"
              ></textarea>
            </div>

            <!-- Решение ученика -->
            <div class="form-group">
              <label class="form-label" for="checker-solution">
                Ваше пошаговое решение:
                <span class="hint-text">(уравнения реакций, расчеты, выводы)</span>
              </label>
              <textarea
                id="checker-solution"
                class="custom-textarea"
                rows="6"
                placeholder="1) Составим уравнение реакции...&#10;2) Рассчитаем количество вещества n = m / M...&#10;3) По закону Гесса..."
              ></textarea>
            </div>

            <!-- Режим проверки -->
            <div class="form-group">
              <label class="form-label">Режим работы AI:</label>
              <div class="pill-group" id="checker-mode-pills">
                <button class="pill-btn active" data-mode="analyze" onclick="setCheckerMode('analyze')">
                  <i class="fas fa-search"></i> 🔍 Полный разбор ошибок
                </button>
                <button class="pill-btn" data-mode="hint" onclick="setCheckerMode('hint')">
                  <i class="fas fa-lightbulb"></i> 💡 Дать подсказку
                </button>
                <button class="pill-btn" data-mode="step_by_step" onclick="setCheckerMode('step_by_step')">
                  <i class="fas fa-list-check"></i> 📝 Пошаговая проверка
                </button>
              </div>
            </div>

            <!-- Язык ответа -->
            <div class="form-group">
              <label class="form-label">Язык рецензии / Тіл / Language:</label>
              <div class="pill-group" id="checker-lang-pills">
                <button class="pill-btn active" data-lang="ru" onclick="setCheckerLang('ru')">🇷🇺 Русский</button>
                <button class="pill-btn" data-lang="kz" onclick="setCheckerLang('kz')">🇰🇿 Қазақша</button>
                <button class="pill-btn" data-lang="en" onclick="setCheckerLang('en')">🇬🇧 English</button>
              </div>
            </div>

            <!-- Кнопки действий -->
            <div class="checker-action-bar">
              <button class="btn-check-ai" id="btn-submit-check" onclick="runAiCheck()">
                <i class="fas fa-sparkles"></i> Запустить проверку AI
              </button>
              <button class="btn btn-secondary" onclick="clearCheckerInputs()">
                <i class="fas fa-trash-alt"></i> Очистить
              </button>
            </div>
          </div>

          <!-- Правая колонка: Результат анализа -->
          <div class="workspace-card" id="checker-result-card">
            <div class="workspace-card-header">
              <div class="workspace-card-title">
                <i class="fas fa-clipboard-check"></i> Рецензия и разбор жюри
              </div>
              <div id="result-status-pill"></div>
            </div>

            <!-- Пустое состояние -->
            <div class="result-empty-state" id="result-empty-state">
              <div class="result-empty-icon">🧪</div>
              <h3>Готов к анализу олимпиадного решения</h3>
              <p style="margin-top: 8px;">
                Выберите задачу из списка или введите условие и ваше решение слева, затем нажмите <strong>«Запустить проверку AI»</strong>.
              </p>
            </div>

            <!-- Индикатор загрузки -->
            <div class="ai-loading-container" id="ai-loading-container">
              <div class="ai-loading-spinner"></div>
              <div class="ai-loading-status" id="ai-loading-step">Анализируем условие и уравнения...</div>
              <div class="ai-loading-subtext">AI проверяет стехиометрию, расчеты и законы химии</div>
            </div>

            <!-- Результат разбора -->
            <div class="analysis-result-content" id="analysis-result-content">
              <div class="ai-markdown" id="ai-analysis-text"></div>

              <div class="result-action-bar">
                <button class="btn btn-secondary" onclick="copyCheckerResult()" style="padding: 8px 14px; font-size: 0.9rem;">
                  <i class="far fa-copy"></i> Скопировать разбор
                </button>
                <button class="btn btn-secondary" onclick="openChatWithContext()" style="padding: 8px 14px; font-size: 0.9rem;">
                  <i class="fas fa-comments"></i> Обсудить в AI-чате
                </button>
              </div>
            </div>

            <!-- Блок сообщения об ошибке -->
            <div id="checker-error-alert" style="display: none;"></div>
          </div>
        </div>

        <div style="text-align: center; margin-bottom: 50px;">
          <button class="btn btn-secondary" onclick="goToPage('chemistry')">
            <i class="fas fa-arrow-left"></i> Назад к химии
