          sampleDraft: "1) Стандартная ЭДС E° = E°(катод) - E°(анод) = +0.337 - (-0.763) = 1.100 В.\n2) Уравнение реакции: Zn + Cu(2+) -> Zn(2+) + Cu (число электронов z = 2).\n3) Уравнение Нернста: E = E° - (0.0592 / 2) * lg([Zn2+] / [Cu2+]).\n4) [Zn2+]/[Cu2+] = 0.01 / 0.50 = 0.02.\n5) lg(0.02) = -1.699.\n6) E = 1.100 - 0.0296 * (-1.699) = 1.100 + 0.0503 = 1.1503 В.\nОтвет: E = 1.150 В."
        },
        {
          id: 402,
          grade: 11,
          section: "Аналитическая",
          title: "Комплексообразование и осаждение (Ksp)",
          stars: 5,
          points: 40,
          time: "60 мин",
          status: "Новая",
          problem: "К 100 мл 0.02 М раствора AgNO3 добавили 100 мл 1.0 М раствора аммиака NH3, после чего добавили 0.001 моль NaCl. Выпадет ли осадок AgCl? (Ksp(AgCl) = 1.8 × 10^(-10), общая константа устойчивости [Ag(NH3)2]+ β2 = 1.6 × 10^7).",
          sampleDraft: "1) После смешения растворов общий объем V = 200 мл = 0.2 л.\n2) Начальные концентрации: C(Ag+) = 0.02 * 0.1 / 0.2 = 0.01 М, C(NH3) = 1.0 * 0.1 / 0.2 = 0.5 М, C(Cl-) = 0.001 / 0.2 = 0.005 М.\n3) Практически все ионы Ag+ перейдут в комплекс [Ag(NH3)2]+:\n[Ag(NH3)2]+ ≈ 0.01 М.\nРавновесный NH3: [NH3] = 0.5 - 2*0.01 = 0.48 М.\n4) Равновесная концентрация свободных ионов серебра:\n[Ag+] = [[Ag(NH3)2]+] / (beta2 * [NH3]^2) = 0.01 / (1.6e7 * 0.48^2) = 0.01 / (3.686e6) = 2.71 × 10^(-9) М.\n5) Произведение концентраций Q = [Ag+] * [Cl-] = (2.71e-9) * 0.005 = 1.355 × 10^(-11).\n6) Сравнение с Ksp: Q (1.355e-11) < Ksp (1.8e-10).\nВывод: Произведение концентраций меньше произведения растворимости, осадок AgCl НЕ выпадет."
        }
      ];

      // Состояние AI Checker
      let selectedCheckerGrade = 10;
      let selectedCheckerMode = "analyze";
      let selectedCheckerLang = "ru";
      let currentActiveTaskCategory = "all";

      // Состояние AI Chat
      let currentChatLang = "ru";
      let chatHistory = [];
      let isAiGenerating = false;

      // Функция перехода между страницами
      function goToPage(pageId) {
        // Скрыть все страницы
        document.querySelectorAll(".page").forEach((page) => {
          page.classList.remove("active");
        });

        // Показать выбранную страницу
        const targetPage = document.getElementById(pageId);
        if (targetPage) {
          targetPage.classList.add("active");
        }

        // Обновить класс на страницах
        const gradeElements = ["current-grade", "tasks-grade", "videos-grade"];
        gradeElements.forEach(id => {
          const el = document.getElementById(id);
          if (el) el.textContent = selectedGrade;
        });

        if (pageId === "videos") {
          initVideoPage();
        } else if (pageId === "tasks") {
          renderTasksList(selectedGrade, currentActiveTaskCategory);
        } else if (pageId === "checker") {
          syncCheckerGrade(selectedGrade);
        }

        // Прокрутить наверх
        window.scrollTo(0, 0);
      }

      // Функция выбора класса
      function selectGrade(grade) {
        selectedGrade = grade;
        selectedCheckerGrade = grade;

        // Снять активный класс со всех кнопок
        document.querySelectorAll(".grade-btn").forEach((btn) => {
          btn.classList.remove("active");
        });

        if (event && event.target) {
          const clickedBtn = event.target.closest(".grade-btn");
          if (clickedBtn) clickedBtn.classList.add("active");
        }

        const continueBtn = document.getElementById("continue-btn");
        if (continueBtn) continueBtn.disabled = false;
      }

      // Отрисовка задач для выбранного класса и раздела
      function renderTasksList(grade = selectedGrade, category = "all") {
        const container = document.getElementById("tasks-list");
        if (!container) return;

        let filtered = olympiadTasksDatabase.filter(t => t.grade === grade || (grade >= 7 && grade <= 8 && t.grade <= 8));
        if (category !== "all") {
          filtered = filtered.filter(t => t.section.toLowerCase().includes(category.toLowerCase()));
        }

        if (filtered.length === 0) {
          // Fallback: показать все задачи близких классов
          filtered = olympiadTasksDatabase;
        }

        container.innerHTML = filtered.map(task => {
          const starsStr = "★".repeat(task.stars) + "☆".repeat(5 - task.stars);
          return `
            <div class="task-card fade-in">
              <div class="task-header">
                <div class="task-title">Тема: ${task.title}</div>
                <div class="stars">${starsStr}</div>
              </div>
              <div class="task-meta">
                <span><i class="far fa-star"></i> ${task.points} баллов</span>
                <span><i class="far fa-clock"></i> ${task.time}</span>
                <span class="tag tag-section" style="margin: 0 5px;">${task.section}</span>
                <span><i class="fas fa-check-circle" style="color: var(--success)"></i> ${task.status}</span>
              </div>
              <p style="margin: 15px 0; color: #374151; white-space: pre-line;">${task.problem}</p>
              <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                <button class="btn" onclick="openCheckerWithTask(${task.id})" style="padding: 10px 20px; background: linear-gradient(135deg, var(--primary), var(--primary-dark));">
                  <i class="fas fa-robot"></i> Решить и проверить с AI
                </button>
              </div>
            </div>
          `;
        }).join("");
      }

      function filterTasks(category) {
        currentActiveTaskCategory = category;
        document.querySelectorAll(".task-filter-btn").forEach(btn => {
          btn.classList.toggle("active", btn.textContent.trim().toLowerCase().includes(category.toLowerCase()) || (category === "all" && btn.textContent.trim() === "Все"));
        });
        renderTasksList(selectedGrade, category);
      }

      function openCheckerWithTask(taskId) {
        const task = olympiadTasksDatabase.find(t => t.id === taskId);
        goToPage("checker");
        if (task) {
          setCheckerGrade(task.grade);
          const select = document.getElementById("checker-task-select");
          if (select) select.value = String(task.id);
          document.getElementById("checker-problem").value = task.problem;
          document.getElementById("checker-solution").value = task.sampleDraft || "";
        }
      }

      // --- ЛОГИКА AI SOLUTION CHECKER ---

      function syncCheckerGrade(grade) {
        selectedCheckerGrade = grade;
        document.querySelectorAll("#checker-grade-pills .pill-btn").forEach(btn => {
          const btnGrade = parseInt(btn.textContent);
          btn.classList.toggle("active", btnGrade === grade);
        });
        populateCheckerTaskSelect(grade);
      }

      function setCheckerGrade(grade) {
        selectedCheckerGrade = grade;
        syncCheckerGrade(grade);
      }

      function populateCheckerTaskSelect(grade) {
        const select = document.getElementById("checker-task-select");
        if (!select) return;

        const tasksForGrade = olympiadTasksDatabase.filter(t => t.grade === grade || (grade >= 7 && grade <= 8 && t.grade <= 8));
        
        let html = `<option value="custom">✏️ Ввести свою олимпиадную задачу...</option>`;
        tasksForGrade.forEach(t => {
          html += `<option value="${t.id}">${t.title} (${t.section}, ${t.points} б.)</option>`;
        });
        select.innerHTML = html;
      }

      function onTaskSelectChange() {
        const select = document.getElementById("checker-task-select");
        const val = select.value;
        if (val === "custom") {
          document.getElementById("checker-problem").value = "";
          document.getElementById("checker-solution").value = "";
          document.getElementById("checker-problem").focus();
        } else {
          const task = olympiadTasksDatabase.find(t => String(t.id) === String(val));
          if (task) {
            document.getElementById("checker-problem").value = task.problem;
            document.getElementById("checker-solution").value = task.sampleDraft || "";
          }
        }
      }

      function setCheckerMode(mode) {
        selectedCheckerMode = mode;
        document.querySelectorAll("#checker-mode-pills .pill-btn").forEach(btn => {
          btn.classList.toggle("active", btn.getAttribute("data-mode") === mode);
        });
      }

      function setCheckerLang(lang) {
        selectedCheckerLang = lang;
        document.querySelectorAll("#checker-lang-pills .pill-btn").forEach(btn => {
          btn.classList.toggle("active", btn.getAttribute("data-lang") === lang);
        });
      }

      function loadSampleDraft() {
        const select = document.getElementById("checker-task-select");
        if (select && select.value !== "custom") {
          const task = olympiadTasksDatabase.find(t => String(t.id) === String(select.value));
          if (task && task.sampleDraft) {
            document.getElementById("checker-solution").value = task.sampleDraft;
            return;
          }
        }
        // Fallback sample
        document.getElementById("checker-problem").value = "Рассчитайте pH 0.05 М раствора уксусной кислоты CH3COOH (Ka = 1.8e-5).";
        document.getElementById("checker-solution").value = "1) CH3COOH <=> CH3COO- + H+\n2) alpha = sqrt(Ka/C) = sqrt(1.8e-5 / 0.05) = 0.0189\n3) [H+] = 0.05 * 0.0189 = 9.45e-4 M\n4) pH = -lg(9.45e-4) = 3.02";
      }

      function clearCheckerInputs() {
        document.getElementById("checker-problem").value = "";
        document.getElementById("checker-solution").value = "";
        document.getElementById("result-empty-state").style.display = "block";
        document.getElementById("analysis-result-content").style.display = "none";
        document.getElementById("ai-loading-container").style.display = "none";
        document.getElementById("checker-error-alert").style.display = "none";
        document.getElementById("result-status-pill").innerHTML = "";
      }

      async function runAiCheck() {
        const problem = document.getElementById("checker-problem").value.trim();
        const solution = document.getElementById("checker-solution").value.trim();
        const errorAlert = document.getElementById("checker-error-alert");
        const emptyState = document.getElementById("result-empty-state");
        const loadingBox = document.getElementById("ai-loading-container");
        const resultContent = document.getElementById("analysis-result-content");
        const textContainer = document.getElementById("ai-analysis-text");
        const statusPill = document.getElementById("result-status-pill");
        const submitBtn = document.getElementById("btn-submit-check");

        errorAlert.style.display = "none";

        if (!problem) {
          alert("Пожалуйста, введите условие задачи для проверки.");
          document.getElementById("checker-problem").focus();
          return;
        }

        if (selectedCheckerMode !== "hint" && !solution) {
          alert("Пожалуйста, введите ваше решение задачи (или выберите режим «Дать подсказку»).");
          document.getElementById("checker-solution").focus();
          return;
        }

        // Show loading state
        emptyState.style.display = "none";
        resultContent.style.display = "none";
        loadingBox.style.display = "block";
        submitBtn.disabled = true;

        // Animated loading messages
        const loadingSteps = [
          "Изучаем условие олимпиадной задачи...",
          "Проверяем стехиометрию и химические уравнения...",
          "Проверяем математические расчеты и законы химии...",
          "Формируем разбор ошибок и рекомендации жюри..."
        ];
        let stepIdx = 0;
        const stepEl = document.getElementById("ai-loading-step");
        const stepInterval = setInterval(() => {
          stepIdx = (stepIdx + 1) % loadingSteps.length;
          if (stepEl) stepEl.textContent = loadingSteps[stepIdx];
        }, 1200);

        try {
          const response = await fetch("/api/check-solution", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              problem,
              solution,
              mode: selectedCheckerMode,
              language: selectedCheckerLang,
              grade: selectedCheckerGrade
            })
          });

          const data = await response.json();
          clearInterval(stepInterval);
          loadingBox.style.display = "none";
          submitBtn.disabled = false;

          if (!response.ok || !data.success) {
            showCheckerError(data.message || data.error || "Ошибка соединения с сервером AI.");
            return;
          }

          const botResponse = data.data?.text || "Анализ завершен.";
          textContainer.innerHTML = formatAiResponse(botResponse);
          resultContent.style.display = "block";

          // Set status badge
          if (selectedCheckerMode === "hint") {
            statusPill.innerHTML = `<span class="badge" style="background: #fef3c7; color: #b45309; margin-bottom: 0;">💡 Подсказка жюри</span>`;
          } else if (selectedCheckerMode === "step_by_step") {
            statusPill.innerHTML = `<span class="badge" style="background: #e0e7ff; color: #4338ca; margin-bottom: 0;">📝 Пошаговый отчет</span>`;
          } else {
            statusPill.innerHTML = `<span class="badge" style="background: #dcfce7; color: #15803d; margin-bottom: 0;">✓ Анализ выполнен</span>`;
          }

        } catch (error) {
          clearInterval(stepInterval);
          loadingBox.style.display = "none";
          submitBtn.disabled = false;
          showCheckerError("Не удалось связаться с сервером AI. Проверьте соединение или настройки .env.");
        }
      }

      function showCheckerError(msg) {
        const errorAlert = document.getElementById("checker-error-alert");
        if (errorAlert) {
          errorAlert.className = "ai-alert-box ai-alert-error";
          errorAlert.innerHTML = `
            <i class="fas fa-exclamation-triangle" style="font-size: 20px;"></i>
            <div>
              <strong>Ошибка AI сервиса:</strong> ${msg}
              <div style="margin-top: 6px; font-size: 0.85rem; color: #7f1d1d;">
                Убедитесь, что сервер запущен (<code>npm start</code>) и в <code>.env</code> задан <code>GEMINI_API_KEY</code>.
              </div>
            </div>
          `;
          errorAlert.style.display = "flex";
        }
      }

      function copyCheckerResult() {
        const textContainer = document.getElementById("ai-analysis-text");
        if (!textContainer) return;
        navigator.clipboard.writeText(textContainer.innerText).then(() => {
          alert("Рецензия успешно скопирована в буфер обмена!");
        }).catch(() => {
          alert("Не удалось скопировать.");
        });
      }

      function openChatWithContext() {
        const problem = document.getElementById("checker-problem").value;
        const solution = document.getElementById("checker-solution").value;
        toggleChat(true);
        const input = document.getElementById("chat-input");
        if (input) {
          input.value = `Помоги подробнее разобраться с задачей: ${problem.slice(0, 100)}...`;
          input.focus();
        }
      }

      // --- ЛОГИКА ЧАТ-БОТА ---

      function toggleChat(forceOpen = false) {
        const chatWindow = document.getElementById("chat-window");
        if (chatWindow) {
          if (forceOpen) chatWindow.classList.add("active");
          else chatWindow.classList.toggle("active");
        }
      }

      function onChatLangChange(lang) {
        currentChatLang = lang;
        const msg = lang === "kz" 
          ? "Тіл қазақшаға ауыстырылды. Сұрағыңызды қойыңыз!" 
          : lang === "en" 
          ? "Language switched to English. Ask your chemistry question!" 
          : "Язык переключен на русский. Чем помочь по химии?";
        addMessage(msg, "bot");
      }

      function sendQuickPrompt(promptText) {
        toggleChat(true);
        const input = document.getElementById("chat-input");
        if (input) {
          input.value = promptText;
          sendMessage();
        }
      }

      function handleEnter(event) {
        if (event.key === "Enter" && !event.shiftKey) {
          event.preventDefault();
          sendMessage();
        }
      }

      async function sendMessage() {
        if (isAiGenerating) return;

        const input = document.getElementById("chat-input");
        const userText = input.value.trim();
        if (!userText) return;

        addMessage(userText, "user");
        input.value = "";
        isAiGenerating = true;

        const loadingId = addTypingIndicator();

        try {
          const response = await fetch("/api/chat", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              message: userText,
              history: chatHistory,
              language: currentChatLang,
              grade: selectedGrade
            })
          });

          const data = await response.json();
          removeTypingIndicator(loadingId);
          isAiGenerating = false;

          if (!response.ok || !data.success) {
            const errorMsg = data.message || "Ошибка соединения с сервером AI.";
            addMessage(`⚠️ ${errorMsg}`, "bot");
            return;
          }

          const botText = data.data?.text || "Ответ получен.";
          chatHistory.push({ role: "user", text: userText });
          chatHistory.push({ role: "model", text: botText });
          if (chatHistory.length > 8) chatHistory = chatHistory.slice(-8);

          addMessage(formatAiResponse(botText), "bot", true);

        } catch (error) {
          removeTypingIndicator(loadingId);
          isAiGenerating = false;
          addMessage("⚠️ Ошибка связи с AI сервером. Пожалуйста, проверьте соединение.", "bot");
        }
      }

      function addMessage(text, sender, isHTML = false) {
        const messagesContainer = document.getElementById("chat-messages");
        if (!messagesContainer) return;
        const msgDiv = document.createElement("div");
        msgDiv.className = `message ${sender}`;

        if (isHTML) {
          msgDiv.innerHTML = text;
        } else {
          msgDiv.textContent = text;
        }

        const id = "msg_" + Date.now();
        msgDiv.setAttribute("data-id", id);
        messagesContainer.appendChild(msgDiv);
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
        return id;
      }

      function addTypingIndicator() {
        const messagesContainer = document.getElementById("chat-messages");
        if (!messagesContainer) return;
        const msgDiv = document.createElement("div");
        msgDiv.className = "message bot";
        const id = "typing_" + Date.now();
        msgDiv.setAttribute("data-id", id);
        msgDiv.innerHTML = `
          <div class="typing-dots">
            <div class="typing-dot"></div>
            <div class="typing-dot"></div>
            <div class="typing-dot"></div>
          </div>
        `;
        messagesContainer.appendChild(msgDiv);
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
        return id;
      }

      function removeTypingIndicator(id) {
        const el = document.querySelector(`[data-id="${id}"]`);
        if (el) el.remove();
      }

      // --- ПАРСЕР И ФОРМАТТЕР MARKDOWN & ХИМИИ ---

      function formatAiResponse(raw) {
        if (!raw) return "";

        let s = raw;

        // Escape dangerous HTML but keep formatting tags
        s = s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

        // Code blocks
        s = s.replace(/```([\s\S]*?)```/g, "<pre><code>$1</code></pre>");
        s = s.replace(/`([^`]+)`/g, "<code>$1</code>");

        // Headers
        s = s.replace(/^### (.*$)/gim, "<h3>$1</h3>");
        s = s.replace(/^## (.*$)/gim, "<h3>$1</h3>");
        s = s.replace(/^# (.*$)/gim, "<h3>$1</h3>");

        // Blockquotes (> text)
        s = s.replace(/^\s*&gt;\s+(.*$)/gim, "<blockquote>$1</blockquote>");

        // Dividers (---)
        s = s.replace(/^\s*---\s*$/gim, "<hr class=\"ai-divider\">");

        // Verification tags (RU, KZ, EN)
        s = s.replace(/\[✓\s*(?:ВЕРНО|ДҰРЫС|CORRECT)\]/gi, `<span class="tag-correct">✓ ВЕРНО</span>`);
        s = s.replace(/\[✓\]/g, `<span class="tag-correct">✓</span>`);
        s = s.replace(/\[✗\s*(?:ОШИБКА|ҚАТЕ|INCORRECT|MISTAKE)\]/gi, `<span class="tag-wrong">✗ ОШИБКА</span>`);
        s = s.replace(/\[✗\]/g, `<span class="tag-wrong">✗</span>`);
        s = s.replace(/\[\?\s*(?:НЕПОЛНО|ТОЛЫҚ ЕМЕС|INCOMPLETE)\]/gi, `<span class="tag-partial">? НЕПОЛНО</span>`);
        s = s.replace(/\[\?\]/g, `<span class="tag-partial">?</span>`);

        // Chemistry LaTeX & symbols cleanup
        s = s.replace(/\\text\{([^}]+)\}/g, "$1");
        s = s.replace(/\\mathrm\{([^}]+)\}/g, "$1");
        s = s.replace(/\\mathbf\{([^}]+)\}/g, "<strong>$1</strong>");
        s = s.replace(/\\frac\{([^}]+)\}\{([^}]+)\}/g, "($1 / $2)");
        s = s.replace(/\\cdot/g, "·");
        s = s.replace(/\\times/g, "×");
        s = s.replace(/\\approx/g, "≈");
        s = s.replace(/\\Delta/g, "Δ");
        s = s.replace(/\\alpha/g, "α");
        s = s.replace(/\\beta/g, "β");
        s = s.replace(/\\gamma/g, "γ");
        s = s.replace(/\\circ/g, "°");
        s = s.replace(/\\degree/g, "°");
        s = s.replace(/\\pm/g, "±");
        s = s.replace(/_\{([0-9a-zA-Z+-]+)\}/g, "<sub>$1</sub>");
        s = s.replace(/_([0-9]+)/g, "<sub>$1</sub>");
        s = s.replace(/\^\{([0-9a-zA-Z+-]+)\}/g, "<sup>$1</sup>");
        s = s.replace(/\^([0-9+-]+)/g, "<sup>$1</sup>");
        s = s.replace(/\$\$/g, "");
        s = s.replace(/\$/g, "");

        // Chemical Arrows
        s = s.replace(/&lt;=&gt;/g, "⇌");
        s = s.replace(/-&gt;/g, "→");

        // Bold & Italic
        s = s.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
        s = s.replace(/\*(.*?)\*/g, "<em>$1</em>");

        // Lists
        s = s.replace(/^\s*-\s+(.*$)/gim, "<li>$1</li>");
        s = s.replace(/^\s*\*\s+(.*$)/gim, "<li>$1</li>");
        s = s.replace(/^\s*(\d+)\.\s+(.*$)/gim, "<li><strong>$1.</strong> $2</li>");

        // Wrap consecutive <li> into <ul>
        s = s.replace(/(<li>[\s\S]*?<\/li>)/g, "<ul>$1</ul>");
        s = s.replace(/<\/ul>\s*<ul>/g, "");

        // Paragraphs & newlines
        const lines = s.split("\n");
        let result = "";
        for (let line of lines) {
          line = line.trim();
          if (!line) continue;
          if (line.startsWith("<h") || line.startsWith("<ul") || line.startsWith("<pre") || line.startsWith("<blockquote") || line.startsWith("<hr")) {
            result += line;
          } else {
            result += `<p>${line}</p>`;
          }
        }

        return result;
      }

      // Проверка статуса сервера AI при загрузке
      async function checkServerHealth() {
        const badge = document.getElementById("ai-server-badge");
        try {
          const res = await fetch("/api/health");
          if (res.ok) {
            const data = await res.json();
            if (badge) {
              if (data.configured) {
                badge.innerHTML = `<i class="fas fa-circle" style="color: #4ade80; font-size: 10px;"></i> Сервер AI активен`;
              } else {
                badge.innerHTML = `<i class="fas fa-exclamation-circle" style="color: #fbbf24; font-size: 10px;"></i> API ключ не задан (.env)`;
              }
            }
          }
        } catch (e) {
          if (badge) {
            badge.innerHTML = `<i class="fas fa-circle" style="color: #9ca3af; font-size: 10px;"></i> Сервер offline`;
          }
        }
      }

      // Инициализация при загрузке
      document.addEventListener("DOMContentLoaded", function () {
        goToPage("home");
        loadLocalOlympiads();
        syncCheckerGrade(10);
        checkServerHealth();

        setTimeout(() => {
          document.querySelectorAll(".fade-in").forEach((el, index) => {
            setTimeout(() => {
              el.style.opacity = 1;
              el.style.transform = "translateY(0)";
            }, index * 100);
          });
        }, 300);
      });
    </script>
  </body>
</html>
