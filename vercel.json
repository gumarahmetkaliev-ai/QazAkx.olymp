{
  "cleanUrls": false,
  "functions": {
    "api/grade.js": {
      "maxDuration": 300,
      "includeFiles": "data/**"
    },
    "api/task-set.js": {
      "includeFiles": "data/tasks/**"
    },
    "api/pdf-proxy.js": {
      "maxDuration": 30,
      "includeFiles": "data/*-sources.json"
    }
  },
  "redirects": [
    {
      "source": "/data/tasks/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/data/:file(.+-sources\\.json)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(lib|scripts|tests|supabase)/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/olympiads/:path(.*\\.pdf)",
      "destination": "/public/olympiads/:path"
    },
    {
      "source": "/olympiads/:id",
      "destination": "/index.html"
    },
    {
      "source": "/books",
      "destination": "/index.html"
    },
    {
      "source": "/progress",
      "destination": "/index.html"
    },
    {
      "source": "/account",
      "destination": "/index.html"
    },
    {
      "source": "/auth/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/public/olympiads/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
