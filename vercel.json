{
  "cleanUrls": false,
  "routes": [
    { "src": "/olympiads/(.+)\\.pdf", "dest": "/public/olympiads/$1.pdf" },
    { "src": "/olympiads/.*", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/olympiads/.*\\.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/public/olympiads/.*\\.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
