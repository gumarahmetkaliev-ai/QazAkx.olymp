{
  "cleanUrls": false,
  "functions": {
    "api/grade.js": { "maxDuration": 60, "includeFiles": "data/**" },
    "api/task-set.js": { "includeFiles": "data/tasks/**" },
    "api/pdf-proxy.js": { "maxDuration": 30, "includeFiles": "data/chemistry-sources.json" }
  },
  "rewrites": [
    { "source": "/olympiads/:path(.*\\.pdf)", "destination": "/public/olympiads/:path" },
    { "source": "/olympiads/:id", "destination": "/index.html" },
    { "source": "/progress", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/auth/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/public/olympiads/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
