{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/olympiads/:path*",
      "destination": "/public/olympiads/:path*"
    }
  ],
  "headers": [
    {
      "source": "/olympiads/:path*.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/public/olympiads/:path*.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
